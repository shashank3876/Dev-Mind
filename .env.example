GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
REDIS_URL=localhost:6379

# Go gateway port
PORT=8080

# Express api-server (auth, sessions) — separate port for local dev
API_SERVER_PORT=3001
VITE_API_PROXY_TARGET=http://localhost:3001

# Python ai-backend (chat, PR review)
VITE_API_URL=http://localhost:8001

# Frontend dev server
APP_ORIGIN=http://localhost:5173

# Database (required for auth sessions and user storage)
DATABASE_URL=postgresql://user:password@localhost:5432/devmind

# Auth sessions
SESSION_SECRET=change-me-to-a-long-random-string
APP_ORIGIN=http://localhost:18130

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
