GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
REDIS_URL=redis://localhost:6379

# Queue backend: redis (local) or pubsub (production Cloud Run)
QUEUE_BACKEND=redis
PUBSUB_TOPIC=devmind-pr-jobs

# Go gateway port
PORT=8080

# Express api-server (auth, sessions, chat quota, billing)
API_SERVER_PORT=3001
VITE_API_PROXY_TARGET=http://localhost:3001
AI_BACKEND_URL=http://localhost:8001

# Python ai-backend (direct calls for PR review)
VITE_API_URL=http://localhost:8001

# Frontend dev server
APP_ORIGIN=http://localhost:5173

# Database (required for auth sessions and user storage)
DATABASE_URL=postgresql://user:password@localhost:5432/devmind

# Auth sessions
SESSION_SECRET=change-me-to-a-long-random-string

# Chat quota (DB app_settings overrides this default)
FREE_CHAT_LIMIT=5

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Razorpay (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_AMOUNT_PAISE=49900

# --- AI backend (Python) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
DEFAULT_LLM_PROVIDER=claude
CLAUDE_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- GCP / Vertex AI ---
# Run: ./scripts/gcp/setup-project.sh <project-id>
# Production: QUEUE_BACKEND=pubsub and DEFAULT_LLM_PROVIDER=vertex (set on Cloud Run).
GCP_PROJECT_ID=
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=local
VERTEX_EMBEDDING_MODEL=text-embedding-004
VECTOR_STORE=qdrant
VERTEX_INDEX_ENDPOINT=
VERTEX_DEPLOYED_INDEX_ID=
USE_GCP_SECRETS=false
USE_GCP_LOGGING=false
USE_GCP_TRACING=false
